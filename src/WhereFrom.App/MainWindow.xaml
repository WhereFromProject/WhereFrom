<Window x:Class="WhereFrom.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhereFrom.App"
        Title="WhereFrom" Width="760" Height="560" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="#F6F7F9"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIf"/>
        <Style x:Key="ReadOnlyField" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Section" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="9"/>
        </Style>
        <DataTemplate x:Key="EvidenceFields">
            <StackPanel Margin="0,0,0,9">
                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Summary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                <Expander Header="{Binding DetailsLabel}" Margin="0,5,0,0"
                          Visibility="{Binding HasDetails, Converter={StaticResource VisibleIf}}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBox Text="{Binding Path, Mode=OneWay}" AutomationProperties.Name="记录路径"
                                 Style="{StaticResource ReadOnlyField}"
                                 Visibility="{Binding HasPath, Converter={StaticResource VisibleIf}}"/>
                        <TextBlock Text="Windows 原始网址可能包含敏感参数。" TextWrapping="Wrap" Margin="0,4,0,4"
                                   Visibility="{Binding IsWindows, Converter={StaticResource VisibleIf}}"/>
                        <ItemsControl ItemsSource="{Binding Urls}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding Value, Mode=OneWay}" AutomationProperties.Name="{Binding Label}"
                                                 Style="{StaticResource ReadOnlyField}"/>
                                        <WrapPanel Margin="0,5,0,0">
                                            <Button Tag="{Binding}" Click="CopyUrl_Click" Padding="8,3" Margin="0,0,8,4"
                                                    Content="{Binding CopyLabel}"/>
                                            <Button Tag="{Binding}" Click="OpenUrl_Click" Padding="8,3" MaxWidth="325"
                                                    Margin="0,0,0,4"
                                                    Visibility="{Binding CanOpen, Converter={StaticResource VisibleIf}}">
                                                <TextBlock Text="{Binding OpenLabel}" TextWrapping="Wrap"/>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <TabControl x:Name="Navigation" Margin="12" SelectionChanged="Navigation_SelectionChanged">
        <TabItem x:Name="FileTab" Header="查文件">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button x:Name="SelectFileButton" Content="选择文件 (_O)" Click="SelectFileButton_Click"
                        HorizontalAlignment="Right" Padding="14,6" Margin="0,0,0,10"/>
                <Border x:Name="DropPanel" Grid.Row="1" MinHeight="120" Padding="16" Background="White"
                        BorderBrush="#9AA9BB" BorderThickness="1" CornerRadius="6">
                    <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="拖入一个文件" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="查看文件来源" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="ResultScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock x:Name="FileNameText" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SourceSummary" FontSize="16" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock x:Name="TimeSummary" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="ResultStatus" TextWrapping="Wrap" Margin="0,7,0,10"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <StackPanel x:Name="EvidencePanel" Visibility="Collapsed">
                            <GroupBox Header="Windows 元数据" Style="{StaticResource Section}">
                                <StackPanel>
                                    <ContentControl x:Name="WindowsEvidence" ContentTemplate="{StaticResource EvidenceFields}"/>
                                    <Expander x:Name="RawMetadataExpander" Header="原始 Zone.Identifier (_R)" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="原始元数据可能包含敏感参数和私人网址。分享前请检查内容。"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBox x:Name="RawMetadataText" Style="{StaticResource ReadOnlyField}"
                                                     AutomationProperties.Name="原始 Zone.Identifier"
                                                     MaxHeight="210" VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="浏览器记录" Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock x:Name="BrowserStatus" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="BrowserEvidence" ItemTemplate="{StaticResource EvidenceFields}">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Heading}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                </StackPanel>
                            </GroupBox>
                            <Expander x:Name="FilePathExpander" Header="当前文件的完整路径">
                                <TextBox x:Name="FilePathText" Style="{StaticResource ReadOnlyField}"
                                         AutomationProperties.Name="当前文件的完整路径"/>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2" x:Name="ActionStatus" TextWrapping="Wrap" Margin="0,5,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="HistoryTab" Header="下载记录">
            <local:DownloadHistoryView x:Name="HistoryView"/>
        </TabItem>
    </TabControl>
</Window>
