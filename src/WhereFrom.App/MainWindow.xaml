<Window x:Class="WhereFrom.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhereFrom" Width="760" Height="560" MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#F6F7F9"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="ReadOnlyField" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button x:Name="SelectFileButton" Content="选择文件" Click="SelectFileButton_Click"
                    DockPanel.Dock="Right" Padding="16,7"/>
            <TextBlock Text="WhereFrom" FontSize="22" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" MinHeight="95" Margin="0,0,0,16" Padding="14"
                Background="White" BorderBrush="#C4CBD4" BorderThickness="1" CornerRadius="7">
            <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="↓" FontSize="27" HorizontalAlignment="Center" Foreground="#52677F"/>
                <TextBlock Text="将单个文件拖放到窗口中，或点击“选择文件”"
                           TextAlignment="Center" Foreground="#52677F"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E0E4E9"
                BorderThickness="1" CornerRadius="7" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <TextBlock Text="文件：" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FileNameTextBox" Style="{StaticResource ReadOnlyField}" Margin="0,0,0,14"/>

                    <TextBlock Text="路径：" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FilePathTextBox" Style="{StaticResource ReadOnlyField}" Margin="0,0,0,14"/>

                    <TextBlock Text="下载地址：" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Margin="0,0,0,14">
                        <Button x:Name="CopySourceButton" Content="复制" Click="CopySourceButton_Click"
                                DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,5" IsEnabled="False"/>
                        <TextBox x:Name="SourceUrlTextBox" Style="{StaticResource ReadOnlyField}"/>
                    </DockPanel>

                    <TextBlock Text="引用页面：" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Margin="0,0,0,14">
                        <Button x:Name="CopyReferrerButton" Content="复制" Click="CopyReferrerButton_Click"
                                DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,5" IsEnabled="False"/>
                        <TextBox x:Name="ReferrerUrlTextBox" Style="{StaticResource ReadOnlyField}"/>
                    </DockPanel>

                    <TextBlock Text="Windows 区域：" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ZoneTextBox" Style="{StaticResource ReadOnlyField}" Margin="0,0,0,14"/>

                    <TextBlock Text="证据来源：" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="EvidenceTextBox" Style="{StaticResource ReadOnlyField}"
                             MinHeight="72" Margin="0,0,0,14"/>

                    <Button x:Name="OpenSourceButton" Content="打开来源网页"
                            Click="OpenSourceButton_Click" Padding="14,7"
                            HorizontalAlignment="Left" IsEnabled="False"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" x:Name="StatusBorder" Visibility="Collapsed"
                Background="#FFF4D4" CornerRadius="5" Padding="12" Margin="0,12,0,0">
            <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
