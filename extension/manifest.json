{
  "manifest_version": 3,
  "name": "WhereFrom Download Capture",
  "version": "0.1.0",
  "description": "Save local provenance for new Chrome and Edge downloads.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "WhereFrom capture status",
    "default_popup": "popup.html"
  },
  "key": ""
}
